/*
 * Banking V1 - CI + Continuous Deployment
 * Jenkins job: Banking-V1-CI-CD
 * Script Path: Jenkinsfile.v1
 *
 * Uses the existing V1 build contexts, Dockerfile paths and image tags
 * declared in compose.v1.yml. Does not modify V2/Kubernetes configuration.
 */
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven399'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout V1 Source') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test V1') {
            steps {
                bat 'mvn -B clean verify'
            }
        }

        stage('Docker Connectivity Check') {
            steps {
                bat 'docker version'
                bat 'docker-compose version'
            }
        }

        stage('Validate V1 Compose Configuration') {
            steps {
                bat '''
                    if not exist "compose.v1.yml" (
                        echo ERROR: compose.v1.yml was not found in the repository root.
                        exit /b 1
                    )
                    docker-compose -f compose.v1.yml config --quiet
                '''
            }
        }

        stage('Build V1 Docker Images') {
            steps {
                bat 'docker-compose -f compose.v1.yml build'
            }
        }

        stage('Deploy V1') {
            steps {
                // Starts V1 and recreates containers when the image/configuration requires it.
                bat 'docker-compose -f compose.v1.yml up -d'
            }
        }

        stage('Verify V1 Containers') {
            steps {
                bat 'docker-compose -f compose.v1.yml ps'
            }
        }
    }

    post {
        success {
            echo 'V1 CI/CD completed: Maven build, image build, deployment and status check succeeded.'
        }
        failure {
            echo 'V1 CI/CD failed. Check the first failed stage in Console Output.'
        }
        always {
            echo 'Banking-V1-CI-CD pipeline finished.'
        }
    }
}

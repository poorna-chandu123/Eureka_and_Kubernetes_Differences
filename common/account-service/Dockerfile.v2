
# V2-specific Dockerfile for Account Service
FROM maven:3.9.9-eclipse-temurin-21 AS build

WORKDIR /workspace
COPY pom.xml .
COPY common ./common
COPY eureka-setup ./eureka-setup

RUN mvn -B -pl common/account-service -am -DskipTests package

# Replace the packaged base application.yml with V2 configuration
RUN set -eux; \
    JAR="$(find /workspace/common/account-service/target -maxdepth 1 -name '*.jar' ! -name '*-plain.jar' | head -n 1)"; \
    test -n "$JAR"; \
    mkdir -p /tmp/v2-config/BOOT-INF/classes; \
    printf '%s\n' \
      'spring:' \
      '  application:' \
      '    name: account-service' \
      '  config:' \
      '    import: "configserver:http://config-server-v2:8888"' \
      > /tmp/v2-config/BOOT-INF/classes/application.yml; \
    cd /tmp/v2-config; \
    jar uf "$JAR" BOOT-INF/classes/application.yml; \
    jar tf "$JAR" | grep -Fx 'BOOT-INF/classes/application.yml'

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/common/account-service/target/*.jar app.jar

EXPOSE 8082
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

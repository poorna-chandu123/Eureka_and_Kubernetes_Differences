# V2-specific Dockerfile.
# Build from the repository root (the folder containing pom.xml):
# docker build -f common/api-gateway/Dockerfile.v2 -t banking-api-gateway:v2-local .
# This file is kept separate for side-by-side comparison with V1.
# V2 behavior (disable Eureka, Kubernetes service routing, Config Server URL)
# must be configured separately in V2 runtime configuration / Kubernetes manifests.

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY common ./common
COPY eureka-setup ./eureka-setup
RUN mvn -B -pl common/api-gateway -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/common/api-gateway/target/*.jar app.jar
EXPOSE 9090
ENTRYPOINT ["java","-jar","/app/app.jar"]

apiVersion: apps/v1
kind: Deployment
metadata:
  name: account-service-v2
  namespace: banking-v2
  labels:
    app: account-service-v2
spec:
  replicas: 1
  selector:
    matchLabels:
      app: account-service-v2
  template:
    metadata:
      labels:
        app: account-service-v2
    spec:
      containers:
        - name: account-service
          image: banking-account-service:v2-local
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8082
          env:
            - name: SPRING_CONFIG_IMPORT
              value: "configserver:http://config-server-v2:8888"
            - name: EUREKA_CLIENT_ENABLED
              value: "false"
            - name: EUREKA_CLIENT_REGISTER_WITH_EUREKA
              value: "false"
            - name: EUREKA_CLIENT_FETCH_REGISTRY
              value: "false"
            - name: SPRING_DATASOURCE_URL
              value: "jdbc:mysql://host.docker.internal:3306/account_service_db?useSSL=false&serverTimezone=Asia/Kolkata"
          readinessProbe:
            tcpSocket:
              port: 8082
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 8082
            initialDelaySeconds: 45
            periodSeconds: 20

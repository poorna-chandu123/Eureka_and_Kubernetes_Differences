pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven399'
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout V2 Source') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test V2') {
            steps {
                bat 'mvn -B clean verify'
            }
        }
		stage('Docker Connectivity Check') {
            steps {
                bat 'docker version'
            }
        }
    }

    post {
        success {
            echo 'V2 CI completed successfully.'
        }
        failure {
            echo 'V2 CI failed. Review the stage logs above.'
        }
    }
}
